# Copy this file to .env and adjust values for your machine.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
