# Copy this file to .env and adjust values for your machine.

# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Database (MySQL)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=fastify_user
DATABASE_PASSWORD=fastify_password
DATABASE_NAME=fastify_db
DATABASE_ROOT_PASSWORD=root_password

# Authentication & Secrets
JWT_SECRET=development-jwt-secret-key-must-be-at-least-32-characters-long
COOKIE_SECRET=development-cookie-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
